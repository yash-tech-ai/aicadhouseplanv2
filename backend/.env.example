# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=caduser
DB_PASSWORD=cadpassword
DB_DATABASE=cad_house_plan

# Database - MongoDB
MONGODB_URI=mongodb://caduser:cadpassword@localhost:27017/cad_metadata?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# File Storage (MinIO/S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=caduser
STORAGE_SECRET_KEY=cadpassword123
STORAGE_BUCKET=cad-drawings
STORAGE_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Upload Limits
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=.dxf,.dwg

# CORS
CORS_ORIGIN=http://localhost:3000

# Matching Algorithm Weights
WEIGHT_GEOMETRIC=0.30
WEIGHT_PARAMETER=0.40
WEIGHT_LAYOUT=0.20
WEIGHT_COMPLIANCE=0.10

# Default Region
DEFAULT_REGION=India
DEFAULT_STATE=Maharashtra
